{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/v2/defi_strategy.schema.json",
  "title": "DefiStrategy",
  "description": "v2.0.0 — BibleFi DeFi yield and staking strategy with protocol metadata, risk parameters, vault integration, tithe allocation, and on-chain attestations on Base chain.",
  "type": "object",
  "required": ["strategy_id", "schema_version", "name", "protocol", "asset", "allocation", "risk_tier", "expected_apy", "tithe_allocation", "rebalance_policy", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "strategy_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "examples": ["2.0.0"] },
    "name": { "type": "string", "minLength": 1 },
    "protocol": { "type": "string", "minLength": 1, "description": "DeFi protocol name, e.g. Aave, Compound, Uniswap, Base native" },
    "asset": {
      "type": "object",
      "required": ["symbol", "contract_address", "chain_id"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "type": "string", "examples": ["USDC", "ETH", "BFI"] },
        "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "chain_id": { "type": "integer", "minimum": 1, "description": "EVM chain ID. Base mainnet = 8453." },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 18 },
        "coingecko_id": { "type": "string" }
      }
    },
    "allocation": {
      "type": "object",
      "required": ["percentage"],
      "additionalProperties": false,
      "properties": {
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "min_usd": { "type": "number", "minimum": 0 },
        "max_usd": { "type": "number", "minimum": 0 }
      }
    },
    "risk_tier": { "type": "string", "enum": ["conservative", "moderate", "aggressive", "speculative"] },
    "expected_apy": { "type": "number", "minimum": 0, "description": "Expected annual percentage yield" },
    "tithe_allocation": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "recipient_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
      }
    },
    "rebalance_policy": {
      "type": "object",
      "required": ["frequency"],
      "additionalProperties": false,
      "properties": {
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "on_threshold", "manual"] },
        "threshold_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "max_slippage_bps": { "type": "integer", "minimum": 0 }
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "Keccak-256 of strategy canonical JSON for on-chain integrity verification on Base chain."
    },
    "biblefi_vault_integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vault_contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "vault_type": { "type": "string", "enum": ["individual", "church_treasury", "tithe_pool", "missions_fund", "emergency_reserve"] },
        "auto_tithe_enabled": { "type": "boolean", "default": false },
        "tithe_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "tithe_recipient_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "tithe_recipient_type": { "type": "string", "enum": ["church", "missions", "charity", "protocol_treasury"] },
        "scripture_backing": {
          "type": "array",
          "description": "Scripture references backing this stewardship strategy. E.g. Malachi 3:10, Proverbs 3:9-10.",
          "items": {
            "type": "object",
            "required": ["book", "chapter", "verses"],
            "additionalProperties": false,
            "properties": {
              "book": { "type": "string" },
              "chapter": { "type": "integer", "minimum": 1 },
              "verses": {
                "oneOf": [
                  { "type": "integer", "minimum": 1 },
                  { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true },
                  { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } } }
                ]
              },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "performance_tracking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_rebalanced_at": { "type": "string", "format": "date-time" },
        "current_apy": { "type": "number" },
        "total_yield_usd": { "type": "number", "minimum": 0 },
        "total_tithe_distributed_usd": { "type": "number", "minimum": 0 },
        "inception_date": { "type": "string", "format": "date-time" },
        "nav_usd": { "type": "number", "minimum": 0, "description": "Net Asset Value in USD" }
      }
    },
    "risk_parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_drawdown_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "stop_loss_enabled": { "type": "boolean" },
        "stop_loss_threshold_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "slippage_tolerance_bps": { "type": "integer", "minimum": 0, "description": "Slippage tolerance in basis points" },
        "gas_budget_eth": { "type": "string", "description": "Maximum ETH budget for gas per rebalance operation" }
      }
    },
    "farcaster_frame_uri": {
      "type": "string",
      "format": "uri",
      "description": "Farcaster Frame URI for this strategy, enabling users to interact with it directly in Farcaster/Warpcast"
    },
    "attestations": {
      "type": "array",
      "description": "On-chain attestations for this strategy on Base chain.",
      "items": {
        "type": "object",
        "required": ["chain_id", "contract_address", "attestation_type"],
        "additionalProperties": false,
        "properties": {
          "chain_id": { "type": "integer", "minimum": 1, "description": "EVM chain ID. Base chain mainnet = 8453." },
          "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "token_id": { "type": "string" },
          "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "attestation_type": { "type": "string", "enum": ["nft_mint", "eas_attestation", "hypercert", "poap", "sbt", "merkle_leaf", "farcaster_frame", "custom"] },
          "block_number": { "type": "integer", "minimum": 0 },
          "ipfs_cid": { "type": "string", "pattern": "^(Qm[1-9A-HJ-NP-Za-km-z]{44}|b[A-Za-z2-7]{58})$" },
          "attested_at": { "type": "string", "format": "date-time" },
          "attested_by": { "type": "string" },
          "merkle_proof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "root": { "type": "string" },
              "proof": { "type": "array", "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" } },
              "leaf_index": { "type": "integer", "minimum": 0 },
              "total_leaves": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "approved_by": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approver_id", "role", "approved_at"],
        "additionalProperties": false,
        "properties": {
          "approver_id": { "type": "string", "format": "uuid" },
          "role": { "type": "string", "enum": ["church_admin", "auditor", "developer"] },
          "approved_at": { "type": "string", "format": "date-time" },
          "signature": { "type": "string", "description": "EVM signature or DID signature" },
          "notes": { "type": "string" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
