{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/v1/scripture_record.schema.json",
  "title": "ScriptureRecord",
  "description": "DEPRECATED v1.0.0 — use scripture_record.schema.json (v2.0.0). Retained for 24 months per BibleFi versioning policy (until 2028-03). Original: A canonicalised reference to a Bible passage, including its text, translation metadata, and optional on-chain attestation details.",
  "type": "object",
  "required": ["record_id", "schema_version", "book", "chapter", "verses", "translation", "text"],
  "additionalProperties": false,
  "properties": {
    "record_id": { "type": "string", "format": "uuid", "description": "Globally unique identifier for this scripture record." },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Semantic version (e.g. '1.0.0').", "examples": ["1.0.0"] },
    "book": { "type": "string", "minLength": 1, "examples": ["Genesis", "Psalms", "John", "Revelation"] },
    "chapter": { "type": "integer", "minimum": 1 },
    "verses": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true }, { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } } }] },
    "translation": { "type": "object", "required": ["abbreviation", "full_name", "language"], "additionalProperties": false, "properties": { "abbreviation": { "type": "string", "minLength": 1 }, "full_name": { "type": "string", "minLength": 1 }, "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2,3})?$" }, "year_published": { "type": "integer", "minimum": 1000 } } },
    "text": { "type": "string", "minLength": 1 },
    "topics": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "attestation": { "type": "object", "required": ["chain_id", "contract_address", "token_id"], "additionalProperties": false, "properties": { "chain_id": { "type": "integer", "minimum": 1 }, "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }, "token_id": { "type": "string" }, "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" } } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
