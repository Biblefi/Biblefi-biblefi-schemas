{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/scripture_record.schema.json",
  "title": "ScriptureRecord",
  "description": "A canonicalised reference to a Bible passage, including its text, translation metadata, and optional on-chain attestation details.",
  "type": "object",
  "required": ["record_id", "schema_version", "book", "chapter", "verses", "translation", "text"],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique identifier for this scripture record."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the ScriptureRecord schema (e.g. '1.0.0').",
      "examples": ["1.0.0"]
    },
    "book": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical book name (e.g. 'Genesis', 'John', 'Revelation').",
      "examples": ["Genesis", "Psalms", "John", "Revelation"]
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "description": "Chapter number within the book."
    },
    "verses": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "description": "Single verse number."
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Array of individual verse numbers."
        },
        {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "description": "Inclusive verse range.",
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 1
            },
            "to": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ],
      "description": "Verse or verse range being referenced."
    },
    "translation": {
      "type": "object",
      "required": ["abbreviation", "full_name", "language"],
      "additionalProperties": false,
      "description": "Bible translation metadata.",
      "properties": {
        "abbreviation": {
          "type": "string",
          "minLength": 1,
          "description": "Short code for the translation (e.g. 'KJV', 'NIV', 'ESV').",
          "examples": ["KJV", "NIV", "ESV", "NLT", "NKJV"]
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "description": "Full name of the translation (e.g. 'King James Version').",
          "examples": ["King James Version", "New International Version"]
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2,3})?$",
          "description": "BCP-47 language tag (e.g. 'en', 'es', 'zh-TW').",
          "examples": ["en", "es", "pt-BR"]
        },
        "year_published": {
          "type": "integer",
          "minimum": 1000,
          "description": "Year the translation was first published."
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Verbatim scripture text for the specified reference."
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Theological or topical tags associated with this passage (e.g. 'faith', 'stewardship', 'prosperity')."
    },
    "attestation": {
      "type": "object",
      "description": "Optional on-chain attestation linking this record to a smart contract or NFT.",
      "required": ["chain_id", "contract_address", "token_id"],
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "type": "integer",
          "minimum": 1,
          "description": "EVM chain ID where the attestation lives (e.g. 1 for Ethereum mainnet)."
        },
        "contract_address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "description": "Address of the attestation smart contract."
        },
        "token_id": {
          "type": "string",
          "description": "Token ID (as a string to handle uint256) of the attestation NFT."
        },
        "tx_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Transaction hash of the mint or registration event."
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when this record was created."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when this record was last updated."
    }
  }
}
