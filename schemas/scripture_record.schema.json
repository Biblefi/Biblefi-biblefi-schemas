    "multi_sig_governance": {
      "type": "object",
      "description": "Scripture Record Amendment Protocol (SRAP) — multi-signature governance model for proposing and ratifying changes to canonical scripture records on-chain.",
      "additionalProperties": false,
      "properties": {
        "governance_contract": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "proposal_id": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "required_signers": {
          "type": "integer",
          "minimum": 1
        },
        "current_signers": {
          "type": "integer",
          "minimum": 0
        },
        "threshold_type": {
          "type": "string",
          "enum": [
            "absolute",
            "percentage",
            "weighted_stake",
            "quadratic"
          ]
        },
        "threshold_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "signers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "address",
              "signed_at",
              "signature"
            ],
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "signed_at": {
                "type": "string",
                "format": "date-time"
              },
              "signature": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{130}$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "pastor",
                  "elder",
                  "deacon",
                  "scholar",
                  "validator",
                  "dao_member",
                  "observer"
                ]
              },
              "stake_weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "ratified_at": {
          "type": "string",
          "format": "date-time"
        },
        "ratification_tx": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "amendment_type": {
          "type": "string",
          "enum": [
            "content_correction",
            "metadata_update",
            "translation_addition",
            "deprecation",
            "restoration",
            "canonical_reclassification"
          ]
        },
        "veto_window_ends": {
          "type": "string",
          "format": "date-time"
        },
        "vetoed_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "EVM addresses that exercised veto."
        }
      }
    },
    "recitation_metrics": {
      "type": "object",
      "description": "Scripture Phonological Complexity Index (SPCI) — quantifies memorability and recitability based on phonological and structural properties.",
      "additionalProperties": false,
      "properties": {
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "syllable_count": {
          "type": "integer",
          "minimum": 0
        },
        "average_syllables_per_word": {
          "type": "number",
          "minimum": 0
        },
        "rhyme_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of line-ending words that rhyme with another."
        },
        "alliteration_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of consecutive word pairs sharing initial phoneme."
        },
        "parallelism_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Structural repetition score — high for Hebrew poetry."
        },
        "memorability_index": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Custom SPCI composite: 20*rhyme + 15*alliteration + 25*parallelism + 20*(1/avg_syllables_per_word normalized) + 20*(1 - normalized_word_count)."
        },
        "phoneme_inventory": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "IPA phonemes present in the passage."
        },
        "stress_pattern": {
          "type": "string",
          "description": "E.g. 'iambic', 'trochaic', 'dactylic', 'irregular'."
        },
        "oral_tradition_classification": {
          "type": "string",
          "enum": [
            "memory_verse",
            "liturgical_refrain",
            "narrative_prose",
            "prophetic_oracle",
            "wisdom_aphorism",
            "doxology",
            "lament",
            "commissioning"
          ]
        }
      }
    },
