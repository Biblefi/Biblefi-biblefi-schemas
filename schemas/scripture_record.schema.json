      "type": "object",
      "description": "Stores multiple versioned vector embeddings for semantic search and clustering, with support for dimensionality reduction coordinates.",
      "additionalProperties": false,
      "properties": {
        "vectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model",
              "dimensions",
              "vector_cid"
            ],
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "dimensions": {
                "type": "integer",
                "minimum": 1
              },
              "vector_cid": {
                "type": "string"
              },
              "quantization": {
                "type": "string",
                "enum": [
                  "none",
                  "int8",
                  "int4",
                  "binary"
                ],
                "default": "none"
              },
              "computed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "umap_coordinates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "n_neighbors": {
              "type": "integer",
              "minimum": 2
            },
            "min_dist": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "metric": {
              "type": "string",
              "enum": [
                "cosine",
                "euclidean",
                "manhattan",
                "correlation"
              ]
            }
          }
        },
        "nearest_neighbors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record_id",
              "similarity"
            ],
            "additionalProperties": false,
            "properties": {
              "record_id": {
                "type": "string",
                "format": "uuid"
              },
              "similarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "distance_metric": {
                "type": "string",
                "enum": [
                  "cosine",
                  "euclidean",
                  "dot_product"
                ]
              }
            }
          }
        }
      }
    }
  }
