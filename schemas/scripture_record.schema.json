        },
        "eastern_orthodox_additional": {
          "type": "boolean",
          "description": "Whether this text is in the additional books accepted by Eastern Orthodox churches."
        },
        "ethiopian_orthodox_additional": {
          "type": "boolean",
          "description": "Whether this text is unique to the Ethiopian Orthodox Tewahedo canon."
        },
        "textual_variants": {
          "type": "array",
          "description": "Known textual variants affecting this passage.",
          "items": {
            "type": "object",
            "required": ["variant_id", "description"],
            "additionalProperties": false,
            "properties": {
              "variant_id": {
                "type": "string",
                "description": "Identifier for this variant (e.g. 'P66-omit-v7')."
              },
              "description": {
                "type": "string",
                "description": "Description of the textual difference."
              },
              "manuscript_source": {
                "type": "string",
                "description": "Manuscript siglum or source (e.g. 'Codex Sinaiticus', 'P66')."
              },
              "variant_type": {
                "type": "string",
                "enum": [
                  "addition",
                  "omission",
                  "substitution",
                  "transposition",
                  "orthographic"
                ],
                "description": "Type of textual variant."
              },
              "significance": {
                "type": "string",
                "enum": ["major", "minor", "trivial"],
                "description": "Theological significance of this variant."
              },
              "modern_translations_affected": {
