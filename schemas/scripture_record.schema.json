{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/v2/scripture_record.schema.json",
  "title": "ScriptureRecord",
  "description": "v2.0.0 — Canonicalised reference to a Bible passage with full translation metadata, AI analysis, hermeneutics, cross-references, on-chain attestations, and BibleFi stewardship tagging. Used by BibleFi agents on Base chain and Farcaster mini-app.",
  "type": "object",
  "required": ["record_id", "schema_version", "book", "chapter", "verses", "translation", "text", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "record_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "examples": ["2.0.0"] },
    "book": { "type": "string", "minLength": 1 },
    "chapter": { "type": "integer", "minimum": 1 },
    "verses": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true },
        { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "translation": {
      "type": "object",
      "required": ["abbreviation", "full_name", "language"],
      "additionalProperties": false,
      "properties": {
        "abbreviation": { "type": "string", "minLength": 1 },
        "full_name": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2,3})?$", "description": "BCP-47 language tag" },
        "year_published": { "type": "integer", "minimum": 1000 },
        "dialect": { "type": "string" },
        "manuscript_tradition": {
          "type": "string",
          "enum": ["masoretic_text", "septuagint", "textus_receptus", "nestle_aland", "dead_sea_scrolls", "vulgate", "other"]
        }
      }
    },
    "text": { "type": "string", "minLength": 1 },
    "content_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "Keccak-256 hash of UTF-8 canonical text after Unicode NFC normalization and whitespace trimming. Compute: keccak256(normalize_nfc(text.trim())). Used for on-chain integrity verification via BibleFi attestation contracts on Base chain."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_organization": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "license": { "type": "string", "enum": ["public_domain", "CC0", "CC_BY", "CC_BY_SA", "proprietary", "fair_use"] },
        "copyright_year": { "type": "integer", "minimum": 1000 },
        "attribution_required": { "type": "boolean" },
        "digitization_source": { "type": "string" }
      }
    },
    "ai_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "embedding_model": { "type": "string" },
        "embedding_version": { "type": "string" },
        "embedding_dimensions": { "type": "integer", "minimum": 1 },
        "semantic_clusters": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Cluster IDs from BibleFi semantic graph"
        },
        "sentiment_score": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0,
          "description": "Valence from -1.0 (lament/judgment) to 1.0 (praise/joy). Used by BibleFi agents for stewardship and devotional recommendations."
        },
        "reading_level": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flesch_kincaid_grade": { "type": "number", "minimum": 0 },
            "flesch_reading_ease": { "type": "number", "minimum": 0, "maximum": 100 },
            "grade_label": { "type": "string", "enum": ["elementary", "middle_school", "high_school", "college", "graduate"] }
          }
        },
        "theological_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["theme", "confidence"],
            "additionalProperties": false,
            "properties": {
              "theme": {
                "type": "string",
                "enum": ["soteriology", "eschatology", "ecclesiology", "pneumatology", "christology", "theodicy", "anthropology", "hamartiology", "cosmology", "ethics", "worship", "stewardship", "missions", "covenant", "kingdom", "wisdom", "law", "prophecy", "apocalyptic"]
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "named_entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["person", "place", "nation", "deity", "artifact", "event", "time_period"] },
              "biblical_id": { "type": "string", "description": "Optional Wikidata-style identifier" }
            }
          }
        }
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["book", "chapter", "verses", "relationship"],
        "additionalProperties": false,
        "properties": {
          "book": { "type": "string" },
          "chapter": { "type": "integer", "minimum": 1 },
          "verses": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true },
              { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } } }
            ]
          },
          "relationship": { "type": "string", "enum": ["parallel", "fulfillment", "quotation", "allusion", "type_antitype", "contrast", "background", "expansion"] },
          "strength": { "type": "string", "enum": ["explicit", "probable", "possible"], "default": "possible" },
          "direction": { "type": "string", "enum": ["forward", "backward", "bidirectional"], "default": "bidirectional" },
          "notes": { "type": "string" }
        }
      }
    },
    "translation_graph": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["abbreviation", "language", "text"],
        "additionalProperties": false,
        "properties": {
          "abbreviation": { "type": "string" },
          "language": { "type": "string" },
          "text": { "type": "string" },
          "content_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "year_published": { "type": "integer", "minimum": 1000 },
          "semantic_similarity_to_primary": { "type": "number", "minimum": 0, "maximum": 1 },
          "notable_differences": { "type": "string" }
        }
      }
    },
    "attestations": {
      "type": "array",
      "description": "On-chain attestations for this scripture record. Replaces singular attestation from v1.",
      "items": {
        "type": "object",
        "required": ["chain_id", "contract_address", "attestation_type"],
        "additionalProperties": false,
        "properties": {
          "chain_id": { "type": "integer", "minimum": 1, "description": "EVM chain ID. Base chain mainnet = 8453." },
          "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "token_id": { "type": "string" },
          "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "attestation_type": { "type": "string", "enum": ["nft_mint", "eas_attestation", "hypercert", "poap", "sbt", "merkle_leaf", "farcaster_frame", "custom"] },
          "block_number": { "type": "integer", "minimum": 0 },
          "ipfs_cid": { "type": "string", "pattern": "^(Qm[1-9A-HJ-NP-Za-km-z]{44}|b[A-Za-z2-7]{58})$" },
          "attested_at": { "type": "string", "format": "date-time" },
          "attested_by": { "type": "string" },
          "merkle_proof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "root": { "type": "string" },
              "proof": { "type": "array", "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" } },
              "leaf_index": { "type": "integer", "minimum": 0 },
              "total_leaves": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "hermeneutics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "literary_genre": { "type": "string", "enum": ["narrative", "poetry", "prophecy", "epistle", "apocalyptic", "wisdom", "law", "gospel", "genealogy", "hymn", "lament", "oracle"] },
        "speech_act": { "type": "string", "enum": ["promise", "command", "warning", "blessing", "curse", "prayer", "doxology", "question", "lament", "declaration", "invitation", "commissioning"] },
        "covenant_context": { "type": "string", "enum": ["adamic", "noahic", "abrahamic", "mosaic", "davidic", "new_covenant", "pre-fall", "eschatological"] },
        "canonical_position": { "type": "string", "enum": ["ot_law", "ot_history", "ot_wisdom", "ot_prophecy", "nt_gospel", "nt_acts", "nt_epistle", "nt_apocalyptic"] },
        "christological_significance": { "type": "string" },
        "typology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is_type": { "type": "boolean" },
            "is_antitype": { "type": "boolean" },
            "type_description": { "type": "string" }
          }
        },
        "interpretive_traditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tradition", "interpretation"],
            "additionalProperties": false,
            "properties": {
              "tradition": { "type": "string", "enum": ["catholic", "reformed", "lutheran", "arminian", "orthodox", "baptist", "pentecostal", "anabaptist", "dispensational", "covenant_theology"] },
              "interpretation": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        },
        "original_language_notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hebrew_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "word": { "type": "string" },
                  "strongs_id": { "type": "string", "pattern": "^H\\d+$" },
                  "gloss": { "type": "string" }
                }
              }
            },
            "greek_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "word": { "type": "string" },
                  "strongs_id": { "type": "string", "pattern": "^G\\d+$" },
                  "gloss": { "type": "string" }
                }
              }
            },
            "aramaic_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "word": { "type": "string" },
                  "strongs_id": { "type": "string" },
                  "gloss": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "stewardship_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "BibleFi-specific stewardship category tags. Examples: 'tithe', 'firstfruits', 'offering', 'almsgiving', 'jubilee', 'gleaning', 'generosity', 'treasury-management'. Used by BibleFi DeFi strategy agents for scripture-backed yield allocation decisions."
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "changed_at", "content_hash_before", "content_hash_after", "change_type"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "changed_at": { "type": "string", "format": "date-time" },
          "changed_by": { "type": "string" },
          "change_type": { "type": "string", "enum": ["text_correction", "metadata_update", "translation_added", "attestation_added", "ai_metadata_refresh", "hermeneutics_update", "cross_reference_added", "schema_migration"] },
          "content_hash_before": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "content_hash_after": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "diff_summary": { "type": "string" },
          "reviewed_by": { "type": "string" }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
