{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/v3/scripture_record.schema.json",
  "title": "ScriptureRecord",
  "description": "v3.0.0 — Canonical reference to a Bible passage with cryptographic content hashing, AI metadata, hermeneutics, cross-references, multi-chain attestations, zero-knowledge proofs, canonical graph traversal, semantic diff, liturgical context, multi-sig governance, recitation metrics, interoperability identifiers, covenant mapping, dispute resolution, and vector embedding index.",
  "type": "object",
  "required": [
    "record_id",
    "schema_version",
    "book",
    "chapter",
    "verses",
    "translation",
    "text",
    "content_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique identifier for this scripture record."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the ScriptureRecord schema.",
      "examples": [
        "3.0.0"
      ]
    },
    "book": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical book name.",
      "examples": [
        "Genesis",
        "Psalms",
        "John",
        "Revelation"
      ]
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "verses": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 1
            },
            "to": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "canonical_verse_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of canonical verses this record covers. Must be consistent with the verses field."
    },
    "translation": {
      "type": "object",
      "required": [
        "abbreviation",
        "full_name",
        "language"
      ],
      "additionalProperties": false,
      "properties": {
        "abbreviation": {
          "type": "string",
          "minLength": 1
        },
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2,3})?$",
          "description": "BCP-47 language tag."
        },
        "year_published": {
          "type": "integer",
          "minimum": 1000
        },
        "dialect": {
          "type": "string"
        },
        "manuscript_tradition": {
          "type": "string",
          "enum": [
            "masoretic_text",
            "septuagint",
            "textus_receptus",
            "nestle_aland",
            "dead_sea_scrolls",
            "vulgate",
            "other"
          ]
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "The scripture passage text."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "Keccak-256 hash of the NFC-normalized, trimmed UTF-8 text."
    },
    "hash_algorithm": {
      "type": "string",
      "enum": [
        "keccak256",
        "sha3_256",
        "blake3",
        "poseidon_bn254"
      ],
      "default": "keccak256",
      "description": "Hash function used to compute content_hash. Default and recommended is keccak256."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_organization": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "enum": [
            "public_domain",
            "CC0",
            "CC_BY",
            "CC_BY_SA",
            "proprietary",
            "fair_use"
          ]
        },
        "copyright_year": {
          "type": "integer",
          "minimum": 1000
        },
        "attribution_required": {
          "type": "boolean"
        },
        "digitization_source": {
          "type": "string"
        }
      }
    },
    "ai_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "embedding_model": {
          "type": "string"
        },
        "embedding_version": {
          "type": "string"
        },
        "embedding_dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "semantic_clusters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sentiment_score": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "reading_level": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flesch_kincaid_grade": {
              "type": "number",
              "minimum": 0
            },
            "flesch_reading_ease": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "grade_label": {
              "type": "string",
              "enum": [
                "elementary",
                "middle_school",
                "high_school",
                "college",
                "graduate"
              ]
            }
          }
        },
        "theological_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "theme",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "theme": {
                "type": "string",
                "enum": [
                  "soteriology",
                  "eschatology",
                  "ecclesiology",
                  "pneumatology",
                  "christology",
                  "theodicy",
                  "anthropology",
                  "hamartiology",
                  "cosmology",
                  "ethics",
                  "worship",
                  "stewardship",
                  "missions",
                  "covenant",
                  "kingdom",
                  "wisdom",
                  "law",
                  "prophecy",
                  "apocalyptic"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "named_entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "person",
                  "place",
                  "nation",
                  "deity",
                  "artifact",
                  "event",
                  "time_period"
                ]
              },
              "biblical_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "book",
          "chapter",
          "verses",
          "relationship"
        ],
        "additionalProperties": false,
        "properties": {
          "book": {
            "type": "string",
            "minLength": 1
          },
          "chapter": {
            "type": "integer",
            "minimum": 1
          },
          "verses": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "to": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          },
          "relationship": {
            "type": "string",
            "enum": [
              "parallel",
              "fulfillment",
              "quotation",
              "allusion",
              "type_antitype",
              "contrast",
              "background",
              "expansion"
            ]
          },
          "strength": {
            "type": "string",
            "enum": [
              "explicit",
              "probable",
              "possible"
            ],
            "default": "possible"
          },
          "direction": {
            "type": "string",
            "enum": [
              "forward",
              "backward",
              "bidirectional"
            ],
            "default": "bidirectional"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "translation_graph": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "abbreviation",
          "language",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "abbreviation": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "year_published": {
            "type": "integer",
            "minimum": 1000
          },
          "semantic_similarity_to_primary": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notable_differences": {
            "type": "string"
          }
        }
      }
    },
    "attestations": {
      "type": "array",
      "description": "On-chain attestation records.",
      "items": {
        "type": "object",
        "required": [
          "chain_id",
          "contract_address",
          "attestation_type"
        ],
        "additionalProperties": false,
        "properties": {
          "chain_id": {
            "type": "integer",
            "minimum": 1
          },
          "contract_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "token_id": {
            "type": "string"
          },
          "tx_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "attestation_type": {
            "type": "string",
            "enum": [
              "nft_mint",
              "eas_attestation",
              "hypercert",
              "poap",
              "sbt",
              "merkle_leaf",
              "custom"
            ]
          },
          "block_number": {
            "type": "integer",
            "minimum": 0
          },
          "ipfs_cid": {
            "type": "string",
            "pattern": "^(Qm[1-9A-HJ-NP-Za-km-z]{44}|b[A-Za-z2-7]{58})$"
          },
          "attested_at": {
            "type": "string",
            "format": "date-time"
          },
          "attested_by": {
            "type": "string"
          },
          "merkle_proof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "root": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "proof": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{64}$"
                }
              },
              "leaf_index": {
                "type": "integer",
                "minimum": 0
              },
              "total_leaves": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "hermeneutics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "literary_genre": {
          "type": "string",
          "enum": [
            "narrative",
            "poetry",
            "prophecy",
            "epistle",
            "apocalyptic",
            "wisdom",
            "law",
            "gospel",
            "genealogy",
            "hymn",
            "lament",
            "oracle"
          ]
        },
        "speech_act": {
          "type": "string",
          "enum": [
            "promise",
            "command",
            "warning",
            "blessing",
            "curse",
            "prayer",
            "doxology",
            "question",
            "lament",
            "declaration",
            "invitation",
            "commissioning"
          ]
        },
        "covenant_context": {
          "type": "string",
          "enum": [
            "adamic",
            "noahic",
            "abrahamic",
            "mosaic",
            "davidic",
            "new_covenant",
            "pre-fall",
            "eschatological"
          ]
        },
        "canonical_position": {
          "type": "string",
          "enum": [
            "ot_law",
            "ot_history",
            "ot_wisdom",
            "ot_prophecy",
            "nt_gospel",
            "nt_acts",
            "nt_epistle",
            "nt_apocalyptic"
          ]
        },
        "christological_significance": {
          "type": "string"
        },
        "typology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is_type": {
              "type": "boolean",
              "default": false
            },
            "is_antitype": {
              "type": "boolean",
              "default": false
            },
            "type_description": {
              "type": "string"
            }
          }
        },
        "interpretive_traditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tradition",
              "interpretation"
            ],
            "additionalProperties": false,
            "properties": {
              "tradition": {
                "type": "string",
                "enum": [
                  "catholic",
                  "reformed",
                  "lutheran",
                  "arminian",
                  "orthodox",
                  "baptist",
                  "pentecostal",
                  "anabaptist",
                  "dispensational",
                  "covenant_theology"
                ]
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "original_language_notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hebrew_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "word",
                  "strongs_id",
                  "gloss"
                ],
                "additionalProperties": false,
                "properties": {
                  "word": {
                    "type": "string"
                  },
                  "strongs_id": {
                    "type": "string",
                    "pattern": "^H\\d+$"
                  },
                  "gloss": {
                    "type": "string"
                  }
                }
              }
            },
            "greek_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "word",
                  "strongs_id",
                  "gloss"
                ],
                "additionalProperties": false,
                "properties": {
                  "word": {
                    "type": "string"
                  },
                  "strongs_id": {
                    "type": "string",
                    "pattern": "^G\\d+$"
                  },
                  "gloss": {
                    "type": "string"
                  }
                }
              }
            },
            "aramaic_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "word",
                  "strongs_id",
                  "gloss"
                ],
                "additionalProperties": false,
                "properties": {
                  "word": {
                    "type": "string"
                  },
                  "strongs_id": {
                    "type": "string"
                  },
                  "gloss": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "revision_history": {
      "type": "array",
      "description": "Immutable append-only log of every change to this record.",
      "items": {
        "type": "object",
        "required": [
          "revision_id",
          "revised_at",
          "revised_by",
          "change_type"
        ],
        "additionalProperties": false,
        "properties": {
          "revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "revised_at": {
            "type": "string",
            "format": "date-time"
          },
          "revised_by": {
            "type": "string",
            "description": "DID or EVM address of the revising entity."
          },
          "change_type": {
            "type": "string",
            "enum": [
              "content_edit",
              "metadata_update",
              "translation_correction",
              "attestation_added",
              "schema_migration",
              "ai_reprocess",
              "governance_ratification"
            ]
          },
          "content_hash_before": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "content_hash_after": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "diff_summary": {
            "type": "string"
          },
          "ratification_ref": {
            "type": "string",
            "description": "Reference to multi_sig_governance.proposal_id if applicable."
          }
        }
      }
    },
    "zero_knowledge_proof": {
      "type": "object",
      "description": "Scripture Commitment Scheme — ZK-friendly structure for proving knowledge of a passage without revealing the text.",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "groth16",
            "plonk",
            "stark",
            "bulletproofs",
            "halo2",
            "nova_folding"
          ]
        },
        "circuit_id": {
          "type": "string",
          "description": "Identifier of the specific ZK circuit."
        },
        "proof_bytes": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$",
          "description": "Hex-encoded proof blob."
        },
        "public_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Public inputs; each a hex uint256."
        },
        "verification_key_uri": {
          "type": "string",
          "format": "uri"
        },
        "commitment": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Pedersen or Poseidon commitment to content_hash."
        },
        "nullifier": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Unique per (record_id, prover_address) pair — prevents double-claiming."
        },
        "prover_address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "description": "EVM address of proof generator."
        },
        "proved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "canonical_graph": {
      "type": "object",
      "description": "BibleFi Canonical Traversal Index — directed acyclic graph of intertextual dependencies enabling topological traversal across the canon.",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string",
          "description": "UUID identifying this node in the canonical graph."
        },
        "canonical_order": {
          "type": "integer",
          "minimum": 1,
          "description": "Position in the BibleFi canonical sequence (weights: NT fulfillment density × OT prophetic occurrence × cross-reference edge count)."
        },
        "in_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_record_id",
              "edge_type"
            ],
            "additionalProperties": false,
            "properties": {
              "source_record_id": {
                "type": "string",
                "format": "uuid"
              },
              "edge_type": {
                "type": "string",
                "enum": [
                  "fulfills",
                  "quotes",
                  "alludes_to",
                  "parallels",
                  "contrasts",
                  "elaborates",
                  "inaugurates",
                  "closes"
                ]
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Theological significance weight."
              },
              "provenance_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "out_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target_record_id",
              "edge_type"
            ],
            "additionalProperties": false,
            "properties": {
              "target_record_id": {
                "type": "string",
                "format": "uuid"
              },
              "edge_type": {
                "type": "string",
                "enum": [
                  "fulfills",
                  "quotes",
                  "alludes_to",
                  "parallels",
                  "contrasts",
                  "elaborates",
                  "inaugurates",
                  "closes"
                ]
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "provenance_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "strongly_connected_component": {
          "type": "integer",
          "minimum": 0,
          "description": "SCC index from Tarjan's algorithm applied to the canon graph."
        },
        "betweenness_centrality": {
          "type": "number",
          "minimum": 0,
          "description": "Normalized betweenness — identifies hub passages."
        },
        "pagerank_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Theological PageRank — passage influence score."
        },
        "clustering_coefficient": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "semantic_diff": {
      "type": "object",
      "description": "Scripture Semantic Delta Algorithm — tracks meaning divergence between this record and previous revisions or translations using cosine similarity and Jensen-Shannon divergence.",
      "additionalProperties": false,
      "properties": {
        "base_record_id": {
          "type": "string",
          "format": "uuid",
          "description": "The record this is diffed against."
        },
        "base_content_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "cosine_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "jensen_shannon_divergence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = identical distributions, 1 = maximally different."
        },
        "edit_distance_normalized": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Levenshtein distance normalized by max(len_a, len_b)."
        },
        "semantic_drift_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Custom weighted score: 0.5*JSD + 0.3*(1-cosine) + 0.2*edit_distance_normalized."
        },
        "changed_theological_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "theme",
              "delta"
            ],
            "additionalProperties": false,
            "properties": {
              "theme": {
                "type": "string",
                "enum": [
                  "soteriology",
                  "eschatology",
                  "ecclesiology",
                  "pneumatology",
                  "christology",
                  "theodicy",
                  "anthropology",
                  "hamartiology",
                  "cosmology",
                  "ethics",
                  "worship",
                  "stewardship",
                  "missions",
                  "covenant",
                  "kingdom",
                  "wisdom",
                  "law",
                  "prophecy",
                  "apocalyptic"
                ]
              },
              "delta": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "description": "Positive = theme strengthened, negative = weakened."
              }
            }
          }
        },
        "diff_model": {
          "type": "string",
          "description": "Embedding model used for comparison."
        },
        "diff_computed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "liturgical_context": {
