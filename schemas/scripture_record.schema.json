{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/v2.1/scripture_record.schema.json",
  "title": "ScriptureRecord",
  "description": "v2.1.0 — Canonical reference to a Bible passage with cryptographic content hashing, AI metadata, hermeneutics, cross-references, multi-chain attestations, full provenance tracking, canonical graph, zero-knowledge proofs, liturgical schedule, temporal integrity, interoperability links, oral tradition, and computational linguistics.",
  "type": "object",
  "required": ["record_id", "schema_version", "book", "chapter", "verses", "translation", "text", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique identifier for this scripture record."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the ScriptureRecord schema (e.g. '2.1.0').",
      "examples": ["2.0.0", "2.1.0"]
    },
    "book": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical book name.",
      "examples": ["Genesis", "Psalms", "John", "Revelation"]
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "verses": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "integer", "minimum": 1 },
            "to": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "translation": {
      "type": "object",
      "required": ["abbreviation", "full_name", "language"],
      "additionalProperties": false,
      "properties": {
        "abbreviation": { "type": "string", "minLength": 1 },
        "full_name": { "type": "string", "minLength": 1 },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2,3})?$",
          "description": "BCP-47 language tag (e.g. 'en', 'en-US', 'heb')."
        },
        "year_published": { "type": "integer", "minimum": 1000 },
        "dialect": { "type": "string" },
        "manuscript_tradition": {
          "type": "string",
          "enum": ["masoretic_text", "septuagint", "textus_receptus", "nestle_aland", "dead_sea_scrolls", "vulgate", "other"]
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "The scripture passage text."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "Keccak-256 hash of the NFC-normalized, trimmed UTF-8 text. Compute as: JS: `keccak256(toBytes(text.normalize('NFC').trim()))` | Python: `'0x' + keccak(unicodedata.normalize('NFC', text.strip()).encode()).hex()`."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "topics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_organization": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "license": {
          "type": "string",
          "enum": ["public_domain", "CC0", "CC_BY", "CC_BY_SA", "proprietary", "fair_use"]
        },
        "copyright_year": { "type": "integer", "minimum": 1000 },
        "attribution_required": { "type": "boolean" },
        "digitization_source": { "type": "string" }
      }
    },
    "ai_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "embedding_model": { "type": "string" },
        "embedding_version": { "type": "string" },
        "embedding_dimensions": { "type": "integer", "minimum": 1 },
        "semantic_clusters": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "sentiment_score": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0,
          "description": "Valence score from -1.0 (lament) to 1.0 (praise)."
        },
        "reading_level": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flesch_kincaid_grade": { "type": "number", "minimum": 0 },
            "flesch_reading_ease": { "type": "number", "minimum": 0, "maximum": 100 },
            "grade_label": {
              "type": "string",
              "enum": ["elementary", "middle_school", "high_school", "college", "graduate"]
            }
          }
        },
        "theological_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["theme", "confidence"],
            "additionalProperties": false,
            "properties": {
              "theme": {
                "type": "string",
                "enum": [
                  "soteriology", "eschatology", "ecclesiology", "pneumatology", "christology",
                  "theodicy", "anthropology", "hamartiology", "cosmology", "ethics",
                  "worship", "stewardship", "missions", "covenant", "kingdom",
                  "wisdom", "law", "prophecy", "apocalyptic"
                ]
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "named_entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["person", "place", "nation", "deity", "artifact", "event", "time_period"]
              },
              "biblical_id": { "type": "string" }
            }
          }
        }
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["book", "chapter", "verses", "relationship"],
        "additionalProperties": false,
        "properties": {
          "book": { "type": "string", "minLength": 1 },
          "chapter": { "type": "integer", "minimum": 1 },
          "verses": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              {
                "type": "array",
                "items": { "type": "integer", "minimum": 1 },
                "minItems": 1,
                "uniqueItems": true
              },
              {
                "type": "object",
                "required": ["from", "to"],
                "additionalProperties": false,
                "properties": {
                  "from": { "type": "integer", "minimum": 1 },
                  "to": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          },
          "relationship": {
            "type": "string",
            "enum": ["parallel", "fulfillment", "quotation", "allusion", "type_antitype", "contrast", "background", "expansion"]
          },
          "strength": {
            "type": "string",
            "enum": ["explicit", "probable", "possible"],
            "default": "possible"
          },
          "direction": {
            "type": "string",
            "enum": ["forward", "backward", "bidirectional"],
            "default": "bidirectional"
          },
          "notes": { "type": "string" }
        }
      }
    },
    "translation_graph": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["abbreviation", "language", "text"],
        "additionalProperties": false,
        "properties": {
          "abbreviation": { "type": "string" },
          "language": { "type": "string" },
          "text": { "type": "string" },
          "content_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "year_published": { "type": "integer", "minimum": 1000 },
          "semantic_similarity_to_primary": { "type": "number", "minimum": 0, "maximum": 1 },
          "notable_differences": { "type": "string" }
        }
      }
    },
    "attestations": {
      "type": "array",
      "description": "On-chain attestation records. Replaces the singular v1 `attestation` field.",
      "items": {
        "type": "object",
        "required": ["chain_id", "contract_address", "attestation_type"],
        "additionalProperties": false,
        "properties": {
          "chain_id": { "type": "integer", "minimum": 1 },
          "contract_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "token_id": { "type": "string" },
          "tx_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "attestation_type": {
            "type": "string",
            "enum": ["nft_mint", "eas_attestation", "hypercert", "poap", "sbt", "merkle_leaf", "custom"]
          },
          "block_number": { "type": "integer", "minimum": 0 },
          "ipfs_cid": {
            "type": "string",
            "pattern": "^(Qm[1-9A-HJ-NP-Za-km-z]{44}|b[A-Za-z2-7]{58})$",
            "description": "IPFS CID (CIDv0 starting with 'Qm' or CIDv1 starting with 'b')."
          },
          "attested_at": { "type": "string", "format": "date-time" },
          "attested_by": { "type": "string" },
          "merkle_proof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "root": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "proof": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{64}$"
                }
              },
              "leaf_index": { "type": "integer", "minimum": 0 },
              "total_leaves": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "hermeneutics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "literary_genre": {
          "type": "string",
          "enum": ["narrative", "poetry", "prophecy", "epistle", "apocalyptic", "wisdom", "law", "gospel", "genealogy", "hymn", "lament", "oracle"]
        },
        "speech_act": {
          "type": "string",
          "enum": ["promise", "command", "warning", "blessing", "curse", "prayer", "doxology", "question", "lament", "declaration", "invitation", "commissioning"]
        },
        "covenant_context": {
          "type": "string",
          "enum": ["adamic", "noahic", "abrahamic", "mosaic", "davidic", "new_covenant", "pre-fall", "eschatological"]
        },
        "canonical_position": {
          "type": "string",
          "enum": ["ot_law", "ot_history", "ot_wisdom", "ot_prophecy", "nt_gospel", "nt_acts", "nt_epistle", "nt_apocalyptic"]
        },
        "christological_significance": { "type": "string" },
        "typology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is_type": { "type": "boolean", "default": false },
            "is_antitype": { "type": "boolean", "default": false },
            "type_description": { "type": "string" }
          }
        },
        "interpretive_traditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tradition", "interpretation"],
            "additionalProperties": false,
            "properties": {
              "tradition": {
                "type": "string",
                "enum": ["catholic", "reformed", "lutheran", "arminian", "orthodox", "baptist", "pentecostal", "anabaptist", "dispensational", "covenant_theology"]
              },
              "interpretation": { "type": "string", "minLength": 1 },
              "source": { "type": "string" }
            }
          }
        },
        "original_language_notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hebrew_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["word", "strongs_id", "gloss"],
                "additionalProperties": false,
                "properties": {
                  "word": { "type": "string" },
                  "strongs_id": {
                    "type": "string",
                    "pattern": "^H\\d+$"
                  },
                  "gloss": { "type": "string" }
                }
              }
            },
            "greek_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["word", "strongs_id", "gloss"],
                "additionalProperties": false,
                "properties": {
                  "word": { "type": "string" },
                  "strongs_id": {
                    "type": "string",
                    "pattern": "^G\\d+$"
                  },
                  "gloss": { "type": "string" }
                }
              }
            },
            "aramaic_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["word", "strongs_id", "gloss"],
                "additionalProperties": false,
                "properties": {
                  "word": { "type": "string" },
                  "strongs_id": { "type": "string" },
                  "gloss": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "changed_at", "content_hash_before", "content_hash_after", "change_type"],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "changed_at": { "type": "string", "format": "date-time" },
          "changed_by": { "type": "string" },
          "content_hash_before": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "content_hash_after": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "change_type": {
            "type": "string",
            "enum": [
              "text_correction", "metadata_update", "translation_added", "attestation_added",
              "ai_metadata_refresh", "hermeneutics_update", "cross_reference_added", "schema_migration"
            ]
          },
          "diff_summary": { "type": "string" },
          "reviewed_by": { "type": "string" }
        }
      }
    },
    "canonical_graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "description": "Passages this verse logically/theologically presupposes.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["record_ref", "dependency_type", "weight"],
            "additionalProperties": false,
            "properties": {
              "record_ref": { "type": "string", "format": "uri", "description": "URI of the depended-upon ScriptureRecord ($id)." },
              "dependency_type": { "type": "string", "enum": ["exegetical", "typological", "doctrinal", "narrative_sequence", "lexical", "intertextual"] },
              "weight": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "Edge weight for PageRank-style canonical authority scoring." },
              "notes": { "type": "string" }
            }
          }
        },
        "depended_on_by": {
          "description": "Passages that presuppose this one.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["record_ref", "dependency_type", "weight"],
            "additionalProperties": false,
            "properties": {
              "record_ref": { "type": "string", "format": "uri" },
              "dependency_type": { "type": "string", "enum": ["exegetical", "typological", "doctrinal", "narrative_sequence", "lexical", "intertextual"] },
              "weight": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        },
        "transitive_closure_depth": {
          "type": "integer",
          "minimum": 0,
          "description": "Pre-computed BFS depth of reachable canonical dependencies."
        },
        "pagerank_score": {
          "type": "number",
          "minimum": 0.0,
          "description": "Canonical authority score derived from weighted PageRank over the full corpus graph."
        },
        "strongly_connected_component_id": {
          "type": "string",
          "description": "Identifier of the Tarjan SCC this node belongs to (cycles indicate circular doctrinal structures — flagged for review)."
        },
        "topological_sort_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Position in the Kahn's-algorithm topological ordering of the full canon DAG."
        }
      }
    },
    "zero_knowledge_proofs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "circuit_id": { "type": "string", "description": "Identifier of the ZK circuit used (e.g., 'biblefi-poseidon-v1')." },
        "proof_system": {
          "type": "string",
          "enum": ["groth16", "plonk", "fflonk", "stark", "bulletproofs", "nova", "halo2"],
          "description": "ZK proof system used."
        },
        "verification_key_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Keccak-256 of the serialized verification key."
        },
        "proof_bytes": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$",
          "description": "Hex-encoded serialized proof."
        },
        "public_inputs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
          "description": "Public inputs to the circuit (e.g., commitment to corpus Merkle root)."
        },
        "commitment": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Poseidon hash commitment to the record fields used in the circuit."
        },
        "nullifier": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Unique nullifier to prevent double-use of a proof in on-chain contexts."
        },
        "membership_corpus": {
          "type": "string",
          "enum": ["protestant_66", "catholic_73", "orthodox_81", "ethiopian_81", "samaritan_pentateuch", "deuterocanon", "apocrypha"],
          "description": "Canonical corpus the membership proof is for."
        },
        "verified_at": { "type": "string", "format": "date-time" },
        "verifier_contract_address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      }
    },
    "liturgical_schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lectionary_occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tradition", "cycle", "sunday_or_feast", "liturgical_season"],
            "additionalProperties": false,
            "properties": {
              "tradition": {
                "type": "string",
                "enum": ["roman_rite_roman_catholic", "revised_common_lectionary", "lutheran_book_of_worship", "book_of_common_prayer", "eastern_orthodox", "ethiopian_orthodox", "coptic_orthodox", "armenian_apostolic", "reformed", "anabaptist"]
              },
              "cycle": {
                "type": "string",
                "enum": ["year_a", "year_b", "year_c", "year_1", "year_2", "annual", "continuous"]
              },
              "sunday_or_feast": { "type": "string", "description": "e.g. 'Proper 12', 'Easter Vigil', 'Pentecost Sunday'" },
              "liturgical_season": {
                "type": "string",
                "enum": ["advent", "christmas", "epiphany", "lent", "holy_week", "easter", "pentecost", "ordinary_time", "kingdom_tide", "trinitytide"]
              },
              "role": {
                "type": "string",
                "enum": ["ot_reading", "psalm", "epistle", "gospel", "canticle", "responsory", "tract", "sequence", "alleluia_verse"]
              },
              "is_primary_reading": { "type": "boolean", "default": false },
              "canonical_color": {
                "type": "string",
                "enum": ["white", "red", "green", "purple", "rose", "blue", "black", "gold"]
              },
              "next_occurrence_iso_date": {
                "type": "string",
                "format": "date",
                "description": "ISO 8601 date of the next scheduled occurrence from reference date."
              }
            }
          }
        },
        "biblefi_rrule": {
          "type": "object",
          "additionalProperties": false,
          "description": "Custom BibleFi Recurrence Rule — extends iCalendar RRULE with liturgical-calendar awareness.",
          "properties": {
            "freq": {
              "type": "string",
              "enum": ["liturgical_weekly", "liturgical_annual", "feast_day", "daily_office", "lectio_continua"]
            },
            "by_season": {
              "type": "array",
              "items": { "type": "string", "enum": ["advent", "christmas", "epiphany", "lent", "holy_week", "easter", "pentecost", "ordinary_time"] }
            },
            "interval": { "type": "integer", "minimum": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "until_iso_date": { "type": "string", "format": "date" },
            "tradition_filter": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "temporal_integrity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tracks content freshness, verification staleness, and temporal drift from authoritative source.",
      "properties": {
        "first_verified_at": { "type": "string", "format": "date-time" },
        "last_verified_at": { "type": "string", "format": "date-time" },
        "verification_interval_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Expected re-verification cadence in days."
        },
        "decay_model": {
          "type": "string",
          "enum": ["linear", "exponential", "step_function", "half_life"],
          "description": "Algorithm used to compute trust_decay_score over time."
        },
        "half_life_days": {
          "type": "number",
          "minimum": 1,
          "description": "For half_life decay model: days until trust_decay_score halves. E.g., 365 = annual refresh cycle."
        },
        "trust_decay_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Current computed trust score (1.0 = freshly verified, approaches 0.0 over time per decay_model)."
        },
        "is_stale": {
          "type": "boolean",
          "description": "True when trust_decay_score < 0.2 or last_verified_at > verification_interval_days ago."
        },
        "source_content_hash_at_last_verification": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "content_hash value at time of last verification — diff against current to detect tampering."
        },
        "drift_detected": {
          "type": "boolean",
          "description": "True if current content_hash differs from source_content_hash_at_last_verification."
        },
        "verification_authority": {
          "type": "string",
          "description": "DID, address, or org name of the verifying authority."
        }
      }
    },
    "interoperability_links": {
      "type": "object",
      "additionalProperties": false,
      "description": "Typed links to related records in other BibleFi schemas and external ontologies.",
      "properties": {
        "church_record_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["church_record_id", "link_type"],
            "additionalProperties": false,
            "properties": {
              "church_record_id": { "type": "string", "format": "uuid" },
              "link_type": { "type": "string", "enum": ["used_in_sermon", "used_in_liturgy", "memorization_verse", "founding_scripture", "mission_statement_basis"] },
              "notes": { "type": "string" }
            }
          }
        },
        "agent_envelope_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["envelope_id", "agent_action"],
            "additionalProperties": false,
            "properties": {
              "envelope_id": { "type": "string", "format": "uuid" },
              "agent_action": { "type": "string", "enum": ["cited_in_reasoning", "used_as_prompt_context", "output_generated_from", "fact_checked_against"] }
            }
          }
        },
        "defi_strategy_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["strategy_id", "theological_basis"],
            "additionalProperties": false,
            "properties": {
              "strategy_id": { "type": "string", "format": "uuid" },
              "theological_basis": { "type": "string", "description": "How this scripture informs the DeFi strategy (e.g., stewardship, tithe mechanics)." }
            }
          }
        },
        "external_ontology_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ontology", "identifier"],
            "additionalProperties": false,
            "properties": {
              "ontology": { "type": "string", "enum": ["bibframe", "osis", "usfm", "sword", "wikidata", "openscriptures", "crosswire", "logos_bible_software", "faithlife"] },
              "identifier": { "type": "string", "description": "The passage identifier in that ontology's namespace (e.g., Wikidata Q-number, OSIS ref)." },
              "uri": { "type": "string", "format": "uri" },
              "equivalence_type": { "type": "string", "enum": ["exact_match", "close_match", "broad_match", "narrow_match", "related_match"] }
            }
          }
        }
      }
    },
    "oral_tradition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transmission_form": {
          "type": "string",
          "enum": ["saga", "legend", "myth", "hymn", "creed", "proverb", "prophetic_oracle", "parable", "aphorism", "genealogy", "law_code", "liturgical_formula", "epistle_fragment", "unknown"]
        },
        "sitz_im_leben": {
          "type": "string",
          "description": "The original life-setting / social context in which the oral unit functioned (form-critical analysis)."
        },
        "estimated_oral_period": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "earliest_bce_ce": { "type": "string", "pattern": "^-?\\d+$", "description": "e.g. '-950' for 950 BCE, '30' for 30 CE." },
            "latest_bce_ce": { "type": "string", "pattern": "^-?\\d+$" },
            "confidence": { "type": "string", "enum": ["high", "moderate", "speculative"] }
          }
        },
        "mnemonic_devices": {
          "type": "array",
          "items": { "type": "string", "enum": ["acrostic", "chiasm", "inclusio", "refrain", "parallelism", "alliteration", "numerical_saying", "wordplay"] },
          "uniqueItems": true,
          "description": "Literary-mnemonic devices detected that aided oral transmission."
        },
        "redaction_stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage_label", "hypothesis"],
            "additionalProperties": false,
            "properties": {
              "stage_label": { "type": "string", "description": "e.g. 'J source', 'Deuteronomistic redaction', 'Pauline interpolation'" },
              "hypothesis": { "type": "string", "enum": ["documentary", "supplementary", "fragmentary", "oral_formulaic", "rhetorical_critical"] },
              "period_bce_ce": { "type": "string", "pattern": "^-?\\d+$" },
              "scholarly_consensus": { "type": "string", "enum": ["majority", "minority", "contested", "fringe"] }
            }
          }
        }
      }
    },
    "computational_linguistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "syntax_tree_format": {
          "type": "string",
          "enum": ["penn_treebank", "universal_dependencies", "rst", "hpsg", "lfg"],
          "description": "Normalized syntax tree format identifier for the syntax_tree_ref encoding."
        },
        "syntax_tree_ref": {
          "type": "string",
          "format": "uri",
          "description": "URI to externally stored parse tree (too large for inline storage)."
        },
        "discourse_structure": {
          "type": "string",
          "enum": ["elaboration", "contrast", "cause_effect", "sequence", "background", "enablement", "motivation", "antithesis", "summary", "restatement"],
          "description": "RST (Rhetorical Structure Theory) discourse relation to its immediate textual context."
        },
        "word_count": { "type": "integer", "minimum": 0 },
        "unique_lemma_count": { "type": "integer", "minimum": 0 },
        "hapax_legomena": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Words appearing only once in the entire corpus — critical for translation studies."
        },
        "morphological_complexity_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Normalized score (0=analytic, 1=highly synthetic/polysynthetic) of the source language morphology."
        },
        "lexical_alignment": {
          "type": "array",
          "description": "Token-level alignment between source language and this translation.",
          "items": {
            "type": "object",
            "required": ["source_token", "target_tokens", "alignment_type"],
            "additionalProperties": false,
            "properties": {
              "source_token": { "type": "string" },
              "source_strongs_id": { "type": "string", "pattern": "^[GH]\\d{1,4}$" },
              "target_tokens": { "type": "array", "items": { "type": "string" } },
              "alignment_type": { "type": "string", "enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many", "null_aligned", "idiomatic"] },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        }
      }
    }
  }
}
