        "transmission_chain_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "description": "Keccak-256 hash of a concatenated ordered list of all known manuscript sigla for this passage. Provides a cryptographic fingerprint of the textual transmission history."
        }
      }
