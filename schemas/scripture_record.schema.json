{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/v2/scripture_record.schema.json",
  "title": "ScriptureRecord",
  "description": "v2.0.0 — A canonicalized reference to a Bible passage, including its text, translation metadata, content hash for on-chain integrity, AI metadata, hermeneutics, cross-references, agentic pipeline links, and attestations on Base chain (chain_id: 8453).",
  "type": "object",
  "required": ["record_id", "schema_version", "book", "chapter", "verses", "translation", "text", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique identifier for this scripture record."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the ScriptureRecord schema (e.g. '2.0.0').",
      "examples": ["2.0.0"]
    },
    "book": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical book name (e.g. 'Genesis', 'John', 'Revelation').",
      "examples": ["Genesis", "Psalms", "John", "Revelation", "Malachi", "Proverbs"]
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "description": "Chapter number within the book."
    },
    "verses": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "description": "Single verse number." },
        {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Array of individual verse numbers."
        },
        {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "description": "Inclusive verse range.",
          "properties": {
            "from": { "type": "integer", "minimum": 1 },
            "to": { "type": "integer", "minimum": 1 }
          }
        }
      ],
      "description": "Verse or verse range being referenced."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Verbatim passage text as it appears in the specified translation."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "Keccak-256 hash of UTF-8 canonical text after Unicode NFC normalization and whitespace trimming. Compute: keccak256(normalize_nfc(text.trim())). Used for on-chain integrity verification via BibleFi attestation contracts deployed on Base chain (chain_id: 8453)."
    },
    "translation": {
      "type": "object",
      "required": ["abbreviation", "full_name", "language"],
      "additionalProperties": false,
      "description": "Bible translation metadata.",
      "properties": {
        "abbreviation": {
          "type": "string",
          "minLength": 1,
          "description": "Short code for the translation (e.g. 'KJV', 'NIV', 'ESV').",
          "examples": ["KJV", "NIV", "ESV", "NLT", "NKJV"]
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "description": "Full name of the translation (e.g. 'King James Version').",
          "examples": ["King James Version", "New International Version"]
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2,3})?$",
          "description": "BCP-47 language tag (e.g. 'en', 'es', 'zh-TW').",
          "examples": ["en", "es", "pt-BR"]
        },
        "year_published": {
          "type": "integer",
          "minimum": 1000,
          "description": "Year the translation was first published."
        },
        "dialect": { "type": "string" },
        "manuscript_tradition": {
          "type": "string",
          "enum": ["masoretic_text", "septuagint", "textus_receptus", "nestle_aland", "dead_sea_scrolls", "vulgate", "other"]
        }
      }
    },
    "topics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Thematic topic tags for this passage."
    },
    "financial_keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Financial theme keywords matched by the scripture_search agent during KJV traversal (e.g. 'debt', 'money', 'wealth', 'tithe', 'mammon', 'treasure', 'usury', 'silver', 'gold'). Populated by the agentic pipeline; empty array indicates no financial keywords were matched."
    },
    "stewardship_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "BibleFi-specific stewardship tags. Examples: tithe, firstfruits, offering, almsgiving, jubilee, gleaning, generosity, treasury-management. Used by BibleFi DeFi strategy agents for scripture-backed yield allocation decisions per Malachi 3:10, Proverbs 3:9."
    },
    "original_language_refs": {
      "type": "array",
      "description": "References to this passage in its original Biblical languages (Hebrew, Greek, or Aramaic), captured by the language_validator subagent.",
      "items": {
        "type": "object",
        "required": ["language", "source_text"],
        "additionalProperties": false,
        "properties": {
          "language": {
            "type": "string",
            "enum": ["hebrew", "greek", "aramaic"],
            "description": "The original language of this reference."
          },
          "source_text": {
            "type": "string",
            "minLength": 1,
            "description": "The passage text in its original script (e.g. Hebrew Unicode, Greek Unicode)."
          },
          "transliteration": {
            "type": "string",
            "description": "Optional romanised transliteration of the original-language text."
          },
          "source_corpus": {
            "type": "string",
            "description": "Name of the source corpus used (e.g. 'Westminster Leningrad Codex', 'NA28', 'Peshitta')."
          }
        }
      }
    },
    "cross_language_validation_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID of the CrossLanguageValidation record produced by the language_validator agent for this scripture. Present only after the language validation stage of the agentic pipeline has completed."
    },
    "theological_validation_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID of the TheologicalValidation record produced by the theological_validator agent for this scripture. Present only after the theological validation stage of the agentic pipeline has completed."
    },
    "attestations": {
      "type": "array",
      "description": "Array of on-chain attestations. Replaces the singular attestation field from v1.0.0. Supports BibleFi attestation contracts on Base chain (chain_id: 8453), EAS, Hypercerts, and Farcaster-gated mints.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain_id", "contract_address", "attestation_type"],
        "properties": {
          "chain_id": { "type": "integer", "minimum": 1, "description": "EVM chain ID. Base mainnet = 8453" },
          "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "token_id": { "type": "string" },
          "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "attestation_type": { "type": "string", "enum": ["nft_mint", "eas_attestation", "hypercert", "poap", "sbt", "merkle_leaf", "farcaster_frame", "custom"] },
          "block_number": { "type": "integer", "minimum": 0 },
          "ipfs_cid": { "type": "string", "pattern": "^(Qm[1-9A-HJ-NP-Za-km-z]{44}|bafy[a-z2-7]{55})$" },
          "attested_at": { "type": "string", "format": "date-time" },
          "attested_by": { "type": "string" },
          "merkle_proof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "root": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
              "proof": { "type": "array", "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" } },
              "leaf_index": { "type": "integer", "minimum": 0 },
              "total_leaves": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "hermeneutics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "literary_genre": { "type": "string", "enum": ["narrative", "poetry", "prophecy", "epistle", "apocalyptic", "wisdom", "law", "gospel", "genealogy", "hymn", "lament", "oracle"] },
        "speech_act": { "type": "string", "enum": ["promise", "command", "warning", "blessing", "curse", "prayer", "doxology", "question", "lament", "declaration", "invitation", "commissioning"] },
        "covenant_context": { "type": "string", "enum": ["adamic", "noahic", "abrahamic", "mosaic", "davidic", "new_covenant", "pre-fall", "eschatological"] },
        "canonical_position": { "type": "string", "enum": ["ot_law", "ot_history", "ot_wisdom", "ot_prophecy", "nt_gospel", "nt_acts", "nt_epistle", "nt_apocalyptic"] },
        "christological_significance": { "type": "string" },
        "typology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is_type": { "type": "boolean" },
            "is_antitype": { "type": "boolean" },
            "type_description": { "type": "string" }
          }
        },
        "interpretive_traditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tradition", "interpretation"],
            "properties": {
              "tradition": { "type": "string", "enum": ["catholic", "reformed", "lutheran", "arminian", "orthodox", "baptist", "pentecostal", "anabaptist", "dispensational", "covenant_theology"] },
              "interpretation": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        },
        "original_language_notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hebrew_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["word", "strongs_id", "gloss"],
                "properties": {
                  "word": { "type": "string" },
                  "strongs_id": { "type": "string", "pattern": "^H\\d+$" },
                  "gloss": { "type": "string" }
                }
              }
            },
            "greek_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["word", "strongs_id", "gloss"],
                "properties": {
                  "word": { "type": "string" },
                  "strongs_id": { "type": "string", "pattern": "^G\\d+$" },
                  "gloss": { "type": "string" }
                }
              }
            },
            "aramaic_keywords": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["word", "strongs_id", "gloss"],
                "properties": {
                  "word": { "type": "string" },
                  "strongs_id": { "type": "string" },
                  "gloss": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "ai_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "embedding_model": { "type": "string" },
        "embedding_version": { "type": "string" },
        "embedding_dimensions": { "type": "integer", "minimum": 1 },
        "semantic_clusters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "sentiment_score": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0,
          "description": "Valence score from -1.0 (lament/judgment) to 1.0 (praise/joy). Used by BibleFi AI agents for stewardship and devotional passage recommendations."
        },
        "reading_level": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flesch_kincaid_grade": { "type": "number", "minimum": 0 },
            "flesch_reading_ease": { "type": "number", "minimum": 0, "maximum": 100 },
            "grade_label": { "type": "string", "enum": ["elementary", "middle_school", "high_school", "college", "graduate"] }
          }
        },
        "theological_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theme", "confidence"],
            "properties": {
              "theme": { "type": "string", "enum": ["soteriology", "eschatology", "ecclesiology", "pneumatology", "christology", "theodicy", "anthropology", "hamartiology", "cosmology", "ethics", "worship", "stewardship", "missions", "covenant", "kingdom", "wisdom", "law", "prophecy", "apocalyptic"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "named_entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["person", "place", "nation", "deity", "artifact", "event", "time_period"] },
              "biblical_id": { "type": "string" }
            }
          }
        }
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["book", "chapter", "verses", "relationship"],
        "properties": {
          "book": { "type": "string", "minLength": 1 },
          "chapter": { "type": "integer", "minimum": 1 },
          "verses": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true },
              { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } } }
            ]
          },
          "relationship": { "type": "string", "enum": ["parallel", "fulfillment", "quotation", "allusion", "type_antitype", "contrast", "background", "expansion"] },
          "strength": { "type": "string", "enum": ["explicit", "probable", "possible"], "default": "possible" },
          "direction": { "type": "string", "enum": ["forward", "backward", "bidirectional"], "default": "bidirectional" },
          "notes": { "type": "string" }
        }
      }
    },
    "translation_graph": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["abbreviation", "language", "text"],
        "properties": {
          "abbreviation": { "type": "string" },
          "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2,3})?$" },
          "text": { "type": "string" },
          "content_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "year_published": { "type": "integer", "minimum": 1000 },
          "semantic_similarity_to_primary": { "type": "number", "minimum": 0, "maximum": 1 },
          "notable_differences": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_organization": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "license": { "type": "string", "enum": ["public_domain", "CC0", "CC_BY", "CC_BY_SA", "proprietary", "fair_use"] },
        "copyright_year": { "type": "integer", "minimum": 1000 },
        "attribution_required": { "type": "boolean", "default": false },
        "digitization_source": { "type": "string" }
      }
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "changed_at", "content_hash_before", "content_hash_after", "change_type"],
        "properties": {
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "changed_at": { "type": "string", "format": "date-time" },
          "changed_by": { "type": "string" },
          "change_type": { "type": "string", "enum": ["text_correction", "metadata_update", "translation_added", "attestation_added", "ai_metadata_refresh", "hermeneutics_update", "cross_reference_added", "schema_migration"] },
          "content_hash_before": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "content_hash_after": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "diff_summary": { "type": "string" },
          "reviewed_by": { "type": "string" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
