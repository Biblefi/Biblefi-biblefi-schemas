{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/v2/agent_envelope.schema.json",
  "title": "AgentEnvelope",
  "description": "v2.0.0 — Universal message wrapper for BibleFi agent communications. Includes routing, security context, Farcaster frame context, and Base chain transaction context. All agent messages in the BibleFi protocol must be wrapped in this envelope.",
  "type": "object",
  "required": ["envelope_id", "schema_version", "created_at", "payload_type", "payload"],
  "additionalProperties": false,
  "properties": {
    "envelope_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "examples": ["2.0.0"] },
    "created_at": { "type": "string", "format": "date-time" },
    "payload_type": {
      "type": "string",
      "enum": ["scripture_record","church_record","defi_strategy","security_finding","wallet_record","user_profile","tithe_transaction","farcaster_frame_event","governance_vote","generic"]
    },
    "payload": { "type": "object" },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_id": { "type": "string" },
        "agent_type": { "type": "string" },
        "wallet_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "fid": { "type": "integer", "minimum": 1 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string" },
        "value": { "type": "string" },
        "signed_at": { "type": "string", "format": "date-time" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destination_agent": { "type": "string", "description": "Target BibleFi agent ID per AGENT_TAXONOMY.md" },
        "source_agent": { "type": "string" },
        "priority": { "type": "string", "enum": ["low","normal","high","critical"], "default": "normal" },
        "ttl_seconds": { "type": "integer", "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0, "default": 0 },
        "correlation_id": { "type": "string", "format": "uuid", "description": "Groups related messages in a conversation/workflow" }
      }
    },
    "security_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": { "type": "string", "enum": ["public","internal","confidential","restricted"] },
        "requires_verification": { "type": "boolean", "default": false },
        "trust_level": { "type": "string", "enum": ["untrusted","low","medium","high","verified"], "description": "Trust level per BibleFi TRUST_BOUNDARIES.md. All agent communications are sandboxed per SANDBOXING_POLICY.md" },
        "sandboxed": { "type": "boolean", "default": true, "description": "Whether this envelope originates from a sandboxed agent per SANDBOXING_POLICY.md in Biblefi/BibleFi" }
      }
    },
    "farcaster_context": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present when envelope originates from a Farcaster Frame interaction. BibleFi is a native Farcaster mini-app.",
      "properties": {
        "cast_hash": { "type": "string" },
        "fid": { "type": "integer", "minimum": 1 },
        "frame_action": { "type": "string" },
        "channel_id": { "type": "string", "description": "Farcaster channel e.g. /biblefi /faith /defi" },
        "frame_uri": { "type": "string", "format": "uri" }
      }
    },
    "base_chain_context": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present when envelope relates to a Base chain transaction. BibleFi primary chain = Base mainnet (chain_id: 8453).",
      "properties": {
        "block_number": { "type": "integer", "minimum": 0 },
        "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "gas_used": { "type": "integer", "minimum": 0 },
        "chain_id": { "type": "integer", "minimum": 1, "description": "Default: 8453 (Base mainnet)" },
        "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
      }
    }
  }
}
