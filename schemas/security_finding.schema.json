{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/security_finding.schema.json",
  "title": "SecurityFinding",
  "description": "v1.0.0 — BibleFi security audit finding with CVSS scoring, CWE classification, and remediation tracking. Used by BibleFi security agents and auditors per THREAT_MODEL.md and INCIDENT_RESPONSE.md in BibleFi/BibleFi.",
  "type": "object",
  "required": ["finding_id", "schema_version", "title", "severity", "status"],
  "additionalProperties": false,
  "properties": {
    "finding_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "examples": ["1.0.0"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
    "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "wont_fix", "false_positive"] },
    "cvss": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "enum": ["3.0", "3.1", "4.0"] },
        "vector_string": { "type": "string" },
        "base_score": { "type": "number", "minimum": 0, "maximum": 10 },
        "temporal_score": { "type": "number", "minimum": 0, "maximum": 10 },
        "environmental_score": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "cwe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^CWE-\\d+$" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "affected_component": { "type": "string" },
    "affected_file": { "type": "string" },
    "affected_line": { "type": "integer", "minimum": 1 },
    "proof_of_concept": { "type": "string" },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recommendation": { "type": "string" },
        "fix_commit": { "type": "string" },
        "resolved_at": { "type": "string", "format": "date-time" },
        "resolved_by": { "type": "string" },
        "verified_by": { "type": "string" }
      }
    },
    "reporter": { "type": "string" },
    "assignee": { "type": "string" },
    "audit_id": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
