{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/v2/church_record.schema.json",
  "title": "ChurchRecord",
  "description": "v2.0.0 — Church or ministry organization profile with on-chain treasury, Farcaster identity, governance model, ministry programs, and attestations. Used by BibleFi on Base chain.",
  "type": "object",
  "required": ["record_id", "schema_version", "name"],
  "additionalProperties": false,
  "properties": {
    "record_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "examples": ["2.0.0"] },
    "name": { "type": "string", "minLength": 1 },
    "denomination": { "type": "string" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "postal_code": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "website": { "type": "string", "format": "uri" }
      }
    },
    "on_chain_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wallet_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "ens_name": { "type": "string" },
        "multisig_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "chain_id": { "type": "integer", "minimum": 1, "description": "EVM chain ID. Base mainnet = 8453." }
      }
    },
    "verified": { "type": "boolean", "default": false },
    "farcaster_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fid": { "type": "integer", "minimum": 1, "description": "Farcaster ID" },
        "username": { "type": "string" },
        "display_name": { "type": "string" },
        "bio": { "type": "string" },
        "custody_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "verified_addresses": {
          "type": "array",
          "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "governance_model": { "type": "string", "enum": ["elder_board", "deacon_led", "congregational", "episcopal", "pastor_led", "council"] },
        "multisig_threshold": { "type": "integer", "minimum": 1 },
        "multisig_signers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
        },
        "voting_contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "dao_enabled": { "type": "boolean", "default": false }
      }
    },
    "treasury_stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_balance_usd": { "type": "number", "minimum": 0 },
        "tithe_received_usd_ytd": { "type": "number", "minimum": 0 },
        "tithe_distributed_usd_ytd": { "type": "number", "minimum": 0 },
        "active_strategies": { "type": "integer", "minimum": 0 },
        "last_updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "ministry_programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["missions", "evangelism", "youth", "worship", "education", "food_bank", "disaster_relief", "community_outreach", "counseling", "discipleship"] },
          "budget_usd": { "type": "number", "minimum": 0 },
          "scripture_foundation": { "type": "string", "description": "Primary scripture basis" },
          "active": { "type": "boolean", "default": true }
        }
      }
    },
    "attestations": {
      "type": "array",
      "description": "On-chain church verification attestations on Base chain.",
      "items": {
        "type": "object",
        "required": ["chain_id", "contract_address", "attestation_type"],
        "additionalProperties": false,
        "properties": {
          "chain_id": { "type": "integer", "minimum": 1, "description": "EVM chain ID. Base chain mainnet = 8453." },
          "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "token_id": { "type": "string" },
          "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "attestation_type": { "type": "string", "enum": ["nft_mint", "eas_attestation", "hypercert", "poap", "sbt", "merkle_leaf", "farcaster_frame", "custom"] },
          "block_number": { "type": "integer", "minimum": 0 },
          "ipfs_cid": { "type": "string", "pattern": "^(Qm[1-9A-HJ-NP-Za-km-z]{44}|b[A-Za-z2-7]{58})$" },
          "attested_at": { "type": "string", "format": "date-time" },
          "attested_by": { "type": "string" },
          "merkle_proof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "root": { "type": "string" },
              "proof": { "type": "array", "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" } },
              "leaf_index": { "type": "integer", "minimum": 0 },
              "total_leaves": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "social_proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_count": { "type": "integer", "minimum": 0 },
        "weekly_attendance": { "type": "integer", "minimum": 0 },
        "founding_year": { "type": "integer", "minimum": 1000 },
        "tax_exempt_id": { "type": "string" },
        "accreditation_body": { "type": "string" }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
