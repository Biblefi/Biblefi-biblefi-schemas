{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biblefi.io/user_profile.schema.json",
  "title": "UserProfile",
  "description": "v1.0.0 — BibleFi user profile. Represents an individual, church admin, auditor, developer, or observer within the BibleFi ecosystem on Base chain and Farcaster mini-app.",
  "type": "object",
  "required": ["user_id", "schema_version", "role"],
  "additionalProperties": false,
  "properties": {
    "user_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "examples": ["1.0.0"] },
    "role": {
      "type": "string",
      "enum": ["individual", "church_admin", "auditor", "developer", "observer"],
      "description": "User role within BibleFi"
    },
    "display_name": { "type": "string" },
    "wallet_addresses": {
      "type": "array",
      "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
      "description": "Associated EVM wallet addresses"
    },
    "church_id": { "type": "string", "format": "uuid", "description": "Links to church_record if user belongs to a church" },
    "farcaster_fid": { "type": "integer", "minimum": 1, "description": "Farcaster ID" },
    "farcaster_username": { "type": "string", "description": "Farcaster username" },
    "preferred_translation": { "type": "string", "description": "Preferred Bible translation abbreviation, e.g. NIV, ESV, KJV" },
    "notification_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tithe_reminders": { "type": "boolean", "default": true },
        "strategy_updates": { "type": "boolean", "default": true },
        "church_announcements": { "type": "boolean", "default": true },
        "devotional_daily": { "type": "boolean", "default": false },
        "farcaster_cast": { "type": "boolean", "default": true },
        "email": { "type": "boolean", "default": false },
        "push": { "type": "boolean", "default": true }
      }
    },
    "stewardship_profile": {
      "type": "object",
      "additionalProperties": false,
      "description": "User's giving and stewardship history summary",
      "properties": {
        "total_tithe_usd_ytd": { "type": "number", "minimum": 0 },
        "total_giving_usd_ytd": { "type": "number", "minimum": 0 },
        "giving_streak_days": { "type": "integer", "minimum": 0 },
        "primary_giving_type": { "type": "string", "enum": ["tithe", "firstfruits", "offering", "almsgiving"] }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
